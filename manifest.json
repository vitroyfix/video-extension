{
  "manifest_version": 3,
  "name": "Media Bridge — Video Downloader",
  "version": "1.12.0",
  "description": "Download videos from almost any website: HLS, DASH, direct files, live streams, and MediaSource players via stream capture.",
  "permissions": [
    "identity",
    "declarativeNetRequest",
    "webRequest",
    "unlimitedStorage",
    "storage",
    "downloads",
    "notifications",
    "tabs",
    "activeTab",
    "offscreen",
    "webNavigation",
    "contextMenus"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-gray-16.png",
      "32": "icons/icon-gray-32.png",
      "48": "icons/icon-gray-48.png",
      "128": "icons/icon-gray-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "mse-capture.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "ffmpeg/core/ffmpeg-core.js",
        "ffmpeg/core/ffmpeg-core.wasm",
        "ffmpeg/ffmpeg/worker.js",
        "ffmpeg/ffmpeg/*.js",
        "ffmpeg/util/*.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "capture-bridge/bridge.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "short_name": "Media Bridge",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Open Media Bridge"
    },
    "download-best-video": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Download the best video detected on this page"
    },
    "download-all-videos": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Download all videos detected on this page"
    }
  }
}
